# Python cache and local tooling
tmp/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
.env
.idea/
.vscode/

# Local data and generated experiment results
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/external/*
!data/external/.gitkeep
outputs/*
!outputs/.gitkeep

# Model checkpoints and large training artifacts
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx

# Kaggle build packages and downloaded outputs
submission/build/*
!submission/build/.gitkeep
submission/kaggle/output/
outputs/kaggle_*/

# Kaggle credentials and local secrets
.kaggle/
access_token
kaggle.json
